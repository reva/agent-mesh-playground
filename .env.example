# Copy to .env and fill in. Never commit .env.

# Infomaniak managed Kubernetes
KUBECONFIG=
KUBE_CONTEXT=

# OpenRouter. Only agentgateway receives this key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3

# Supabase Postgres. Use the shared pooler host in session mode (port 5432),
# not the direct connection: the direct host is IPv6-only on the free plan.
# postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/<db>?sslmode=require
KAGENT_DATABASE_URL=
AGENTREGISTRY_DATABASE_URL=
