# Copy to .env and fill in. Never commit .env.

# Infomaniak managed Kubernetes
KUBECONFIG=
KUBE_CONTEXT=

# OpenRouter. Only agentgateway receives this key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3

# Supabase Postgres. Used by scripts/db-spike.mjs against the default database.
# Use the shared pooler host in session mode (port 5432),
# not the direct connection: the direct host is IPv6-only on the free plan.
# Percent-encode the password if it contains @ : / ? # or %.
# postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=

# Per-component URLs, filled in after the phase 3 spike decides the layout.
KAGENT_DATABASE_URL=
AGENTREGISTRY_DATABASE_URL=
