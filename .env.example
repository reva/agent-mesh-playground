# Copy to .env and fill in. Never commit .env.

# Infomaniak managed Kubernetes
KUBECONFIG=
KUBE_CONTEXT=

# OpenRouter. Only agentgateway receives this key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3

# Supabase Postgres. Always the session pooler on port 5432, never the direct
# db.<ref>.supabase.co host: that one is IPv6-only and unreachable from the
# cluster. Percent-encode the password if it contains @ : / ? # or %.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=

# One database per component. `npm run db:provision` creates them and prints
# these two lines ready to paste.
KAGENT_DATABASE_URL=
AGENTREGISTRY_DATABASE_URL=

# The issue refiner. Leave both empty to deploy without it.
# The token is a fine-grained PAT on GITHUB_REPO alone, with read and write on
# Issues and read on Contents. Nothing else: the agent's only write is a comment.
GITHUB_REPO=
GITHUB_TOKEN=
